# gtinx-plane API / worker / beat / migrate - shared environment
# Copy to /etc/gtinx-plane/api.env  (chmod 600, owned by root:gtinx)

DEBUG=0
DOCKERIZED=0
SECRET_KEY="change-me-please-generate-a-random-50-char-secret"
WEB_URL="http://localhost"
CORS_ALLOWED_ORIGINS="http://localhost,https://localhost"
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600

# --- PostgreSQL ---
POSTGRES_USER="gtinx_plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="127.0.0.1"
POSTGRES_DB="gtinx_plane"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://gtinx_plane:gtinx_plane@127.0.0.1:5432/gtinx_plane"

# --- Redis / Valkey ---
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_URL="redis://127.0.0.1:6379/"
REDIS_SSL_CERT_REQS="required"
REDIS_SSL_CA_CERTS=""

# --- RabbitMQ ---
RABBITMQ_HOST="127.0.0.1"
RABBITMQ_PORT="5672"
RABBITMQ_USER="gtinx_plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="gtinx_plane"
# AMQP_URL="amqp://gtinx_plane:gtinx_plane@127.0.0.1:5672/gtinx_plane"

# --- Object storage (S3 or MinIO) ---
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://127.0.0.1:9000"
AWS_S3_BUCKET_NAME="uploads"
BUCKET_NAME="uploads"
USE_MINIO=0

# --- Gunicorn ---
GUNICORN_WORKERS=4
PORT=8000

# --- Public base URLs (must match proxy.Caddyfile / SITE_ADDRESS) ---
ADMIN_BASE_URL="http://localhost"
ADMIN_BASE_PATH="/god-mode"
SPACE_BASE_URL="http://localhost"
SPACE_BASE_PATH="/spaces"
APP_BASE_URL="http://localhost"
APP_BASE_PATH=""
LIVE_BASE_URL="http://localhost"
LIVE_BASE_PATH="/live"

# Must match LIVE_SERVER_SECRET_KEY in /etc/gtinx-plane/live.env
LIVE_SERVER_SECRET_KEY="change-me-please-generate-a-random-50-char-secret"

HARD_DELETE_AFTER_DAYS=60
MINIO_ENDPOINT_SSL=0
API_KEY_RATE_LIMIT="60/minute"
# NUM_PROXIES=1

# Plane reverse proxy (Caddy) - environment for proxy.Caddyfile
# Copy to /etc/plane/proxy.env  (chmod 600, owned by root:plane)

# Proxy listen address.
#   :80                      -> plain HTTP (put your own TLS terminator in front)
#   plane.example.com        -> automatic HTTPS via Let's Encrypt
#   http://plane.example.com -> HTTP on port 80 for that host
SITE_ADDRESS=":80"

FILE_SIZE_LIMIT=5242880
BUCKET_NAME="uploads"

# Only when sites are behind another trusted proxy/load balancer
# TRUSTED_PROXIES="10.0.0.0/8"

# gtinx-plane reverse proxy (Caddy) - environment for proxy.Caddyfile
# Copy to /etc/gtinx-plane/proxy.env  (chmod 600, owned by root:gtinx)

# Proxy listen address.
#   :80                          -> plain HTTP (put your own TLS terminator in front)
#   gtinx-plane.example.com      -> automatic HTTPS via Let's Encrypt
#   http://gtinx-plane.example.com -> HTTP on port 80 for that host
SITE_ADDRESS=":80"

FILE_SIZE_LIMIT=5242880
BUCKET_NAME="uploads"

# Only when sites are behind another trusted proxy/load balancer
# TRUSTED_PROXIES="10.0.0.0/8"

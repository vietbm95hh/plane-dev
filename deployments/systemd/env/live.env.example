# Plane live collaboration server
# Copy to /etc/plane/live.env  (chmod 600, owned by root:plane)

PORT=3100
API_BASE_URL="http://127.0.0.1:8000"
WEB_BASE_URL="http://localhost"
LIVE_BASE_URL="http://localhost"
LIVE_BASE_PATH="/live"

# Must match LIVE_SERVER_SECRET_KEY in /etc/plane/api.env
LIVE_SERVER_SECRET_KEY="change-me-please-generate-a-random-50-char-secret"

REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_URL="redis://127.0.0.1:6379/"

# Optional: comma separated list of allowed origins (defaults to WEB_BASE_URL)
# CORS_ALLOWED_ORIGINS="http://localhost"

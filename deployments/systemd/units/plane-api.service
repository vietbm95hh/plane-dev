[Unit]
Description=Plane - API (Django + gunicorn/uvicorn)
Documentation=file:///opt/plane/deployments/systemd/README.md
After=network-online.target plane-migrate.service
Wants=network-online.target
Requires=plane-migrate.service

[Service]
Type=simple
User=plane
Group=plane
WorkingDirectory=/opt/plane/apps/api
Environment=PATH=/opt/plane/apps/api/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PORT=8000
Environment=GUNICORN_WORKERS=4
EnvironmentFile=/etc/gtinx_plane/api.env
ExecStart=/bin/bash /opt/plane/apps/api/bin/docker-entrypoint-api.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plane-api

# Hardening (relax if you keep uploads/logs outside /opt/plane)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/plane/apps/api/gtinx_plane/logs /opt/plane/apps/api/static

[Install]
WantedBy=multi-user.target

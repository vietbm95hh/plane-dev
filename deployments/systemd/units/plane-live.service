[Unit]
Description=Plane - Live collaboration server (Hocuspocus)
Documentation=file:///opt/plane/deployments/systemd/README.md
After=network-online.target plane-api.service
Wants=network-online.target plane-api.service

[Service]
Type=simple
User=plane
Group=plane
WorkingDirectory=/opt/plane/apps/live
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOST=127.0.0.1
EnvironmentFile=/etc/plane/live.env
ExecStart=/usr/bin/node /opt/plane/apps/live/dist/start.mjs
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plane-live

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target

[Unit]
Description=gtinx-plane - API (Django + gunicorn/uvicorn)
Documentation=file:///opt/gtinx-plane/deployments/systemd/README.md
After=network-online.target gtinx-plane-migrate.service
Wants=network-online.target
Requires=gtinx-plane-migrate.service

[Service]
Type=simple
User=gtinx
Group=gtinx
WorkingDirectory=/opt/gtinx-plane/apps/api
Environment=PATH=/opt/gtinx-plane/apps/api/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PORT=8000
Environment=GUNICORN_WORKERS=4
EnvironmentFile=/etc/gtinx-plane/api.env
ExecStart=/bin/bash /opt/gtinx-plane/apps/api/bin/docker-entrypoint-api.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gtinx-plane-api

# Hardening (relax if you keep uploads/logs outside /opt/gtinx-plane)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/gtinx-plane/apps/api/gtinx_plane/logs /opt/gtinx-plane/apps/api/static

[Install]
WantedBy=multi-user.target

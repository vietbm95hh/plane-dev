[Unit]
Description=Plane - database migrations (oneshot)
Documentation=file:///opt/plane/deployments/systemd/README.md
After=network-online.target
Wants=network-online.target
Before=plane-api.service plane-worker.service plane-beat.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=plane
Group=plane
WorkingDirectory=/opt/plane/apps/api
EnvironmentFile=/etc/plane/api.env
Environment=PATH=/opt/plane/apps/api/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/bash /opt/plane/apps/api/bin/docker-entrypoint-migrator.sh
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plane-migrate

[Install]
WantedBy=multi-user.target

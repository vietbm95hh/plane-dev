[Unit]
Description=Plane - Celery beat scheduler
Documentation=file:///opt/plane/deployments/systemd/README.md
After=network-online.target plane-migrate.service
Wants=network-online.target
Requires=plane-migrate.service

[Service]
Type=simple
User=plane
Group=plane
WorkingDirectory=/opt/plane/apps/api
Environment=PATH=/opt/plane/apps/api/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/gtinx_plane/api.env
ExecStart=/bin/bash /opt/plane/apps/api/bin/docker-entrypoint-beat.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plane-beat

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/plane/apps/api/gtinx_plane/logs

[Install]
WantedBy=multi-user.target
